import {
  LayoutDashboard,
  Network,
  LockKeyhole,
  ShieldCheck,
  GitBranch,
  Database,
  Activity,
  Settings,
  LogOut,
  X,
  User,
} from "lucide-react";
import { useAuth } from "../context/AuthContext";

export const NAVIGATION_ITEMS = [
  { id: "overview", label: "Overview", icon: LayoutDashboard },
  { id: "workflow", label: "Workflow Explorer", icon: Network },
  { id: "integrity", label: "Integrity Center", icon: LockKeyhole },
  { id: "trust", label: "Trust Analytics", icon: ShieldCheck },
  { id: "impact", label: "Impact Analysis", icon: GitBranch },
  { id: "sources", label: "Data Sources", icon: Database },
  { id: "health", label: "System Health", icon: Activity },
  { id: "settings", label: "Settings", icon: Settings },
];

export default function Sidebar({
  activePage,
  onNavigate,
  isOpen,
  onClose,
  backendConnected = true,
}) {
  const { user, logout } = useAuth();

  return (
    <>
      <aside className={`sidebar ${isOpen ? "sidebar-open" : ""}`}>
        {/* Brand */}
        <div className="brand">
          <div className="brand-mark">
            <ShieldCheck size={24} />
          </div>
          <div>
            <h1>ProofMesh</h1>
            <span>AI TRUST & PROVENANCE</span>
          </div>
          <button
            className="mobile-close icon-button"
            onClick={onClose}
            aria-label="Close menu"
          >
            <X size={19} />
          </button>
        </div>

        {/* Navigation */}
        <div className="sidebar-label">WORKSPACE</div>
        <nav className="sidebar-nav">
          {NAVIGATION_ITEMS.map(({ id, label, icon: Icon }) => (
            <button
              key={id}
              className={`nav-link ${activePage === id ? "active" : ""}`}
              onClick={() => {
                onNavigate(id);
                if (onClose) onClose();
              }}
            >
              <Icon size={18} />
              <span>{label}</span>
            </button>
          ))}
        </nav>

        {/* Bottom Section */}
        <div className="sidebar-bottom">
          {/* Status badge */}
          <div className="sidebar-status">
            <span
              className={`mini-dot ${backendConnected ? "online" : "warning"}`}
            />
            <div>
              <strong>Backend Status</strong>
              <small>
                {backendConnected ? "FastAPI Operational" : "Backend Offline"}
              </small>
            </div>
          </div>

          {/* User Profile & Logout */}
          {user && (
            <div
              className="sidebar-user"
              style={{
                display: "flex",
                alignItems: "center",
                justifyContent: "space-between",
                padding: "10px 12px",
                marginTop: "10px",
                background: "var(--panel-soft)",
                borderRadius: "10px",
                border: "1px solid var(--border)",
              }}
            >
              <div
                style={{
                  display: "flex",
                  alignItems: "center",
                  gap: "10px",
                  overflow: "hidden",
                }}
              >
                <div
                  style={{
                    width: 32,
                    height: 32,
                    borderRadius: "50%",
                    background: "var(--accent-soft)",
                    color: "var(--accent)",
                    display: "grid",
                    placeItems: "center",
                    flexShrink: 0,
                  }}
                >
                  <User size={16} />
                </div>
                <div style={{ overflow: "hidden" }}>
                  <div
                    style={{
                      fontSize: "12px",
                      fontWeight: 650,
                      color: "var(--text)",
                      whiteSpace: "nowrap",
                      overflow: "hidden",
                      textOverflow: "ellipsis",
                    }}
                  >
                    {user.username}
                  </div>
                  <div
                    style={{
                      fontSize: "10px",
                      color: "var(--muted)",
                      textTransform: "capitalize",
                    }}
                  >
                    {user.role || "User"}
                  </div>
                </div>
              </div>
              <button
                className="icon-button"
                onClick={logout}
                title="Log out"
                style={{
                  color: "var(--muted)",
                  padding: "6px",
                  borderRadius: "6px",
                }}
              >
                <LogOut size={16} />
              </button>
            </div>
          )}

          <div className="sidebar-version">PROOFMESH · v1.0 ENTERPRISE</div>
        </div>
      </aside>

      {/* Mobile backdrop */}
      {isOpen && (
        <button
          className="sidebar-overlay"
          onClick={onClose}
          aria-label="Close sidebar backdrop"
        />
      )}
    </>
  );
}

