import { useState, useMemo } from "react";
import {
  Database,
  Search,
  Filter,
  ArrowUpDown,
  ExternalLink,
  X,
  Code,
  Tag,
  Share2,
} from "lucide-react";
import LoadingState from "../components/LoadingState";
import ErrorState from "../components/ErrorState";

export default function DataSources({
  workflowData,
  isLoading,
  error,
  onRefresh,
}) {
  const [searchQuery, setSearchQuery] = useState("");
  const [selectedType, setSelectedType] = useState("ALL");
  const [sortBy, setSortBy] = useState("id");
  const [selectedItem, setSelectedItem] = useState(null);

  const nodes = workflowData?.nodes || [];
  const relationships = workflowData?.relationships || [];

  // Filter and sort items
  const filteredNodes = useMemo(() => {
    return nodes
      .filter((node) => {
        const matchesType =
          selectedType === "ALL" || node.type === selectedType;
        const matchesQuery =
          !searchQuery ||
          String(node.id).toLowerCase().includes(searchQuery.toLowerCase()) ||
          String(node.type).toLowerCase().includes(searchQuery.toLowerCase()) ||
          JSON.stringify(node.properties || {})
            .toLowerCase()
            .includes(searchQuery.toLowerCase());
        return matchesType && matchesQuery;
      })
      .sort((a, b) => {
        if (sortBy === "id") return String(a.id).localeCompare(String(b.id));
        if (sortBy === "type") return String(a.type).localeCompare(String(b.type));
        if (sortBy === "props")
          return (
            Object.keys(b.properties || {}).length -
            Object.keys(a.properties || {}).length
          );
        return 0;
      });
  }, [nodes, selectedType, searchQuery, sortBy]);

  if (isLoading && !workflowData) {
    return <LoadingState message="Fetching provenance component registry..." />;
  }

  if (error && !workflowData) {
    return (
      <ErrorState
        title="Failed to load data sources"
        message={error}
        onRetry={onRefresh}
      />
    );
  }

  return (
    <div
      className="page-container"
      style={{ display: "flex", flexDirection: "column", gap: "24px" }}
    >
      {/* Header */}
      <div
        style={{
          background: "var(--panel)",
          border: "1px solid var(--border)",
          borderRadius: "14px",
          padding: "24px",
        }}
      >
        <div className="eyebrow">GRAPH COMPONENT REGISTRY</div>
        <h2 style={{ fontSize: "22px", fontWeight: 750, color: "var(--text)", margin: "4px 0" }}>
          Data Sources & Provenance Records
        </h2>
        <p style={{ color: "var(--muted)", fontSize: "13px", margin: 0, maxWidth: 680 }}>
          All discrete entities tracked in the Neo4j graph: autonomous agents, tool invocations, ingested knowledge bases, and model decision records.
        </p>
      </div>

      {/* Filter and Search Controls */}
      <div
        className="filter-bar"
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          flexWrap: "wrap",
          gap: "14px",
          background: "var(--panel)",
          border: "1px solid var(--border)",
          borderRadius: "12px",
          padding: "16px 20px",
        }}
      >
        {/* Type Filter Tabs */}
        <div style={{ display: "flex", gap: "4px", flexWrap: "wrap" }}>
          {["ALL", "Agent", "Tool", "DataSource", "Decision"].map((t) => (
            <button
              key={t}
              onClick={() => setSelectedType(t)}
              style={{
                border: "none",
                background:
                  selectedType === t ? "var(--accent-soft)" : "transparent",
                color: selectedType === t ? "var(--accent)" : "var(--muted)",
                padding: "6px 14px",
                borderRadius: "8px",
                fontSize: "12px",
                fontWeight: 650,
                cursor: "pointer",
                transition: "all 0.15s ease",
              }}
            >
              {t}
            </button>
          ))}
        </div>

        {/* Search & Sort */}
        <div style={{ display: "flex", alignItems: "center", gap: "12px" }}>
          {/* Search */}
          <div style={{ position: "relative", width: 220 }}>
            <Search
              size={14}
              style={{
                position: "absolute",
                left: "10px",
                top: "50%",
                transform: "translateY(-50%)",
                color: "var(--muted)",
              }}
            />
            <input
              type="text"
              placeholder="Filter records..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              style={{
                width: "100%",
                padding: "7px 12px 7px 32px",
                borderRadius: "8px",
                border: "1px solid var(--border)",
                background: "var(--panel-soft)",
                color: "var(--text)",
                fontSize: "12px",
                outline: "none",
                boxSizing: "border-box",
              }}
            />
          </div>

          {/* Sort selector */}
          <div style={{ display: "flex", alignItems: "center", gap: "6px" }}>
            <ArrowUpDown size={14} style={{ color: "var(--muted)" }} />
            <select
              value={sortBy}
              onChange={(e) => setSortBy(e.target.value)}
              style={{
                padding: "7px 10px",
                borderRadius: "8px",
                border: "1px solid var(--border)",
                background: "var(--panel-soft)",
                color: "var(--text)",
                fontSize: "12px",
                outline: "none",
              }}
            >
              <option value="id">Sort by ID</option>
              <option value="type">Sort by Type</option>
              <option value="props">Sort by Property Count</option>
            </select>
          </div>
        </div>
      </div>

      {/* Records Table */}
      <div
        className="panel"
        style={{
          background: "var(--panel)",
          border: "1px solid var(--border)",
          borderRadius: "14px",
          overflow: "hidden",
        }}
      >
        <div style={{ overflowX: "auto" }}>
          <table
            style={{
              width: "100%",
              borderCollapse: "collapse",
              textAlign: "left",
              fontSize: "13px",
            }}
          >
            <thead>
              <tr
                style={{
                  borderBottom: "1px solid var(--border)",
                  background: "var(--panel-soft)",
                  color: "var(--subtle)",
                  fontSize: "11px",
                  fontWeight: 700,
                  textTransform: "uppercase",
                  letterSpacing: "0.5px",
                }}
              >
                <th style={{ padding: "14px 20px" }}>Entity Type</th>
                <th style={{ padding: "14px 20px" }}>Identifier (ID)</th>
                <th style={{ padding: "14px 20px" }}>Display Name / Key Properties</th>
                <th style={{ padding: "14px 20px" }}>Connected Relations</th>
                <th style={{ padding: "14px 20px", textAlign: "right" }}>Action</th>
              </tr>
            </thead>
            <tbody>
              {filteredNodes.length > 0 ? (
                filteredNodes.map((node) => {
                  const typeColors = {
                    Agent: { bg: "rgba(59, 130, 246, 0.12)", text: "#60a5fa" },
                    Tool: { bg: "rgba(139, 92, 246, 0.12)", text: "#a78bfa" },
                    DataSource: { bg: "rgba(16, 185, 129, 0.12)", text: "#34d399" },
                    Decision: { bg: "rgba(245, 158, 11, 0.12)", text: "#fbbf24" },
                  };
                  const color = typeColors[node.type] || {
                    bg: "rgba(100, 116, 139, 0.12)",
                    text: "#94a3b8",
                  };

                  const connectedCount = relationships.filter(
                    (r) =>
                      String(r.source) === String(node.id) ||
                      String(r.target) === String(node.id)
                  ).length;

                  return (
                    <tr
                      key={node.id}
                      onClick={() => setSelectedItem(node)}
                      style={{
                        borderBottom: "1px solid var(--border)",
                        cursor: "pointer",
                        transition: "background 0.15s ease",
                      }}
                      onMouseEnter={(e) => {
                        e.currentTarget.style.background = "var(--panel-soft)";
                      }}
                      onMouseLeave={(e) => {
                        e.currentTarget.style.background = "transparent";
                      }}
                    >
                      <td style={{ padding: "14px 20px" }}>
                        <span
                          style={{
                            fontSize: "11px",
                            fontWeight: 700,
                            padding: "3px 8px",
                            borderRadius: "6px",
                            background: color.bg,
                            color: color.text,
                          }}
                        >
                          {node.type}
                        </span>
                      </td>

                      <td
                        style={{
                          padding: "14px 20px",
                          fontWeight: 650,
                          color: "var(--text)",
                          fontFamily: "monospace",
                          fontSize: "12px",
                        }}
                      >
                        {node.id}
                      </td>

                      <td style={{ padding: "14px 20px", color: "var(--muted)" }}>
                        {node.properties?.name ||
                          node.properties?.model ||
                          (node.properties?.status
                            ? `Status: ${node.properties.status}`
                            : `${Object.keys(node.properties || {}).length} properties`)}
                      </td>

                      <td style={{ padding: "14px 20px" }}>
                        <span
                          style={{
                            display: "inline-flex",
                            alignItems: "center",
                            gap: "5px",
                            fontSize: "11px",
                            color: "var(--subtle)",
                          }}
                        >
                          <Share2 size={13} />
                          <span>{connectedCount} edges</span>
                        </span>
                      </td>

                      <td style={{ padding: "14px 20px", textAlign: "right" }}>
                        <button
                          onClick={(e) => {
                            e.stopPropagation();
                            setSelectedItem(node);
                          }}
                          style={{
                            border: "none",
                            background: "var(--panel-soft)",
                            color: "var(--accent)",
                            padding: "6px 12px",
                            borderRadius: "6px",
                            fontSize: "12px",
                            fontWeight: 600,
                            cursor: "pointer",
                          }}
                        >
                          Inspect
                        </button>
                      </td>
                    </tr>
                  );
                })
              ) : (
                <tr>
                  <td
                    colSpan={5}
                    style={{
                      padding: "48px 20px",
                      textAlign: "center",
                      color: "var(--muted)",
                    }}
                  >
                    No provenance entities match the selected criteria.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      {/* Inspect Item Modal / Drawer */}
      {selectedItem && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            background: "rgba(0, 0, 0, 0.65)",
            backdropFilter: "blur(4px)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: "20px",
            zIndex: 100,
          }}
          onClick={() => setSelectedItem(null)}
        >
          <div
            style={{
              background: "var(--panel)",
              border: "1px solid var(--border)",
              borderRadius: "16px",
              padding: "28px",
              maxWidth: "600px",
              width: "100%",
              maxHeight: "85vh",
              overflowY: "auto",
              boxShadow: "0 20px 40px rgba(0,0,0,0.3)",
              display: "flex",
              flexDirection: "column",
              gap: "20px",
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <div
              style={{
                display: "flex",
                justifyContent: "space-between",
                alignItems: "flex-start",
              }}
            >
              <div>
                <span
                  style={{
                    fontSize: "11px",
                    fontWeight: 750,
                    textTransform: "uppercase",
                    padding: "3px 8px",
                    borderRadius: "4px",
                    background: "var(--accent-soft)",
                    color: "var(--accent)",
                  }}
                >
                  {selectedItem.type}
                </span>
                <h3
                  style={{
                    fontSize: "18px",
                    fontWeight: 750,
                    color: "var(--text)",
                    margin: "8px 0 0",
                    wordBreak: "break-all",
                  }}
                >
                  {selectedItem.properties?.name || selectedItem.id}
                </h3>
              </div>

              <button
                className="icon-button"
                onClick={() => setSelectedItem(null)}
                style={{ padding: "6px" }}
              >
                <X size={18} />
              </button>
            </div>

            {/* Properties key-value breakdown */}
            <div>
              <div
                style={{
                  fontSize: "11px",
                  fontWeight: 700,
                  color: "var(--subtle)",
                  textTransform: "uppercase",
                  letterSpacing: "0.5px",
                  marginBottom: "8px",
                }}
              >
                Raw Stored Properties
              </div>

              <div
                style={{
                  background: "var(--panel-soft)",
                  border: "1px solid var(--border)",
                  borderRadius: "10px",
                  padding: "12px",
                  display: "flex",
                  flexDirection: "column",
                  gap: "8px",
                }}
              >
                {Object.entries(selectedItem.properties || {}).map(([k, v]) => (
                  <div
                    key={k}
                    style={{
                      display: "flex",
                      flexDirection: "column",
                      padding: "4px 0",
                      borderBottom: "1px solid var(--border)",
                    }}
                  >
                    <span style={{ fontSize: "11px", color: "var(--muted)", fontWeight: 600 }}>
                      {k}
                    </span>
                    <span
                      style={{
                        fontSize: "12px",
                        color: "var(--text)",
                        marginTop: "2px",
                        wordBreak: "break-word",
                        fontFamily: typeof v === "object" ? "monospace" : "inherit",
                      }}
                    >
                      {typeof v === "object" ? JSON.stringify(v, null, 2) : String(v)}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <div style={{ textAlign: "right" }}>
              <button
                onClick={() => setSelectedItem(null)}
                style={{
                  padding: "8px 18px",
                  borderRadius: "8px",
                  border: "1px solid var(--border)",
                  background: "var(--panel-soft)",
                  color: "var(--text)",
                  fontSize: "13px",
                  fontWeight: 600,
                  cursor: "pointer",
                }}
              >
                Close Inspector
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

