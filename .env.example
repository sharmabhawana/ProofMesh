# ============================================================
# ProofMesh — Environment Configuration Template
# ============================================================

# Neo4j Provenance Graph Database Configuration
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=proofmesh

# PostgreSQL Authentication Database Configuration (SQLAlchemy)
# Example PostgreSQL URL:
DATABASE_URL=postgresql+psycopg2://YOUR_USER:YOUR_PASSWORD@localhost:5432/proofmesh
# Or SQLite fallback for local development:
# DATABASE_URL=sqlite:///auth/users.db

# Authentication Security (JWT)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Comma-separated exact frontend origins; never use * with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google Gemini LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
