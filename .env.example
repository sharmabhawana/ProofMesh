# ============================================================
# ProofMesh — Environment Configuration Template
# ============================================================
# Copy this file to .env and configure the values for your environment.
# Never commit the .env file containing real secrets to version control.

# Application Environment Mode
# Set to 'production' on hosted cloud servers (Render, Railway, Fly.io, AWS, etc.)
# Set to 'development' on local developer workstations.
ENVIRONMENT=development

# Neo4j Provenance Graph Database Configuration
# Local instance default: bolt://127.0.0.1:7687
# Free-tier cloud instances (e.g. Neo4j AuraDB): neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=proofmesh

# PostgreSQL Authentication Database Configuration (SQLAlchemy)
# In production (ENVIRONMENT=production), PostgreSQL is strictly required.
# In local development, leaving DATABASE_URL empty or unset will fall back to local SQLite.
# Example PostgreSQL URL:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/proofmesh
# Local development SQLite option:
# DATABASE_URL=sqlite:///auth/users.db

# Authentication Security (JWT Signing Key)
# Must be at least 32 characters long. In production, ProofMesh will refuse to start
# if this key is missing, shorter than 32 characters, or using a placeholder value.
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-production-jwt-secret-key-min-32-chars-long

# Cross-Origin Resource Sharing (CORS) Configuration
# Comma-separated list of allowed frontend origins.
# Include local development URLs and your deployed production frontend domain (e.g. Vercel).
# Note: Wildcard '*' is strictly prohibited when allow_credentials=True per web security standards.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://proofmesh.vercel.app

# Google Gemini LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ============================================================
# Email Service — Password Recovery (SMTP / Resend)
# ============================================================
# ProofMesh supports two production email engines:
#   1. SMTP: Gmail (App Password), SendGrid, AWS SES, Brevo, custom SMTP
#   2. Resend API: Free tier (100 emails/day, 3000/mo), HTTPS port 443 (firewall-proof)
#
# Leave EMAIL_PROVIDER empty or 'auto' to automatically detect based on keys.
# Leave all email credentials unset to run in local development mode (logs links to console).
EMAIL_PROVIDER=auto

# Option A: Direct SMTP Configuration
# Gmail setup instructions:
#   - Enable 2-Step Verification on your Google Account
#   - Generate an App Password at: https://myaccount.google.com/apppasswords
#   - Set SMTP_USER to your gmail address, SMTP_PASSWORD to the 16-char app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here
EMAIL_FROM=no-reply@proofmesh.local
SMTP_TLS=true

# Option B: Resend REST API Configuration (Alternative, free-tier cloud friendly)
# Sign up at https://resend.com and create an API key
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your_resend_api_key_here
# EMAIL_FROM=onboarding@resend.dev

# Base URL of the deployed frontend (used to construct clickable reset links)
# In development: http://localhost:5173
# In production: https://proofmesh.vercel.app
FRONTEND_URL=http://localhost:5173
